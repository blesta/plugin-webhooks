<?php /** @var View $this */ ?>

<?php
echo ($message ?? null);

$this->Widget->clear();
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminMain.view.boxtitle_viewwebhook', true), ['id' => 'admin_main_view'], ($render_section ?? null));
?>
<div class="card-body">
    <div class="row">
        <div class="col-lg-6 ps-lg-2 pe-lg-0">
            <h6 class="form-section-header"><?php $this->_('AdminMain.view.heading_webhook');?></h6>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><?php $this->_('AdminMain.view.heading_callback');?></th>
                        <th><?php $this->_('AdminMain.view.heading_type');?></th>
                        <th><?php $this->_('AdminMain.view.heading_method');?></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><?php echo $this->Html->safe($webhook->callback ?? null);?></td>
                        <td><?php echo $this->Html->safe($types[$webhook->type] ?? null);?></td>
                        <td><?php echo $this->Html->safe($methods[$webhook->method] ?? null);?></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="col-lg-6">
            <h6 class="form-section-header"><?php $this->_('AdminMain.view.heading_events');?></h6>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><?php $this->_('AdminMain.view.heading_event');?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php
                    foreach ($webhook->events ?? [] as $event) {
                    ?>
                        <tr>
                            <td><?php echo $this->Html->safe($event ?? null);?></td>
                        </tr>
                    <?php
                    }
                    ?>
                </tbody>
            </table>
        </div>
    </div>

    <?php
    if (!empty($webhook->fields ?? [])) {
    ?>
        <h6 class="form-section-header"><?php $this->_('AdminMain.view.heading_fields_map');?></h6>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th><?php $this->_('AdminMain.view.heading_field');?></th>
                    <th><?php $this->_('AdminMain.view.heading_parameter');?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                foreach ($webhook->fields ?? [] as $field) {
                    $field = (array) $field;
                ?>
                    <tr>
                        <td><?php echo $this->Html->safe($field['field'] ?? '');?></td>
                        <td><?php echo $this->Html->safe($field['parameter'] ?? '');?></td>
                    </tr>
                <?php
                }
                ?>
            </tbody>
        </table>
    <?php
    }
    ?>

    <h6 class="form-section-header"><?php $this->_('AdminMain.view.heading_logs');?></h6>
    <table class="table table-hover">
        <thead>
            <tr>
                <th><?php $this->_('AdminMain.view.heading_event');?></th>
                <th><?php $this->_('AdminMain.view.heading_response');?></th>
                <th><?php $this->_('AdminMain.view.heading_http_response');?></th>
                <th><?php $this->_('AdminMain.view.heading_date_triggered');?></th>
                <th><?php $this->_('AdminMain.view.heading_date_last_retry');?></th>
                <th><?php $this->_('AdminMain.view.heading_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            foreach ($logs ?? [] as $log) {
            ?>
                <tr>
                    <td><?php echo $this->Html->safe($log->event ?? '');?></td>
                    <td>
                        <?php
                        $this->Form->fieldTextarea('response', ($log->response ?? ''), ['class' => 'form-control', 'rows' => 4]);
                        ?>
                    </td>
                    <td><?php echo $this->Html->safe($log->http_response ?? '');?></td>
                    <td><?php echo $this->Date->cast($log->date_triggered, 'date_time');?></td>
                    <td><?php echo !empty($log->date_last_retry) ? $this->Date->cast($log->date_last_retry, 'date_time') : '';?></td>
                    <td>
                        <?php
                        $this->Form->create($this->base_uri . 'plugin/webhooks/admin_main/retry/', ['class' => 'd-inline']);
                        $this->Form->fieldHidden('id', ($log->id ?? null));
                        ?>
                        <button type="button" class="btn btn-sm btn-outline-secondary modal-confirm" data-confirm-message="<?php echo $this->Html->safe($this->_('AdminMain.view.confirm_retry', true));?>" title="<?php $this->_('AdminMain.view.option_retry');?>">
                            <i class="bi bi-arrow-repeat"></i>
                        </button>
                        <?php
                        $this->Form->end();
                        ?>
                    </td>
                </tr>
            <?php
            }
            ?>
        </tbody>
    </table>
</div>
<?php
if (isset($this->Pagination) && $this->Pagination->hasPages()) {
    $this->Widget->footer();
    $this->Pagination->build();
}
$this->Widget->end();
?>
