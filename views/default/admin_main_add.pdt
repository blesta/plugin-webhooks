<?php /** @var View $this */ ?>

<?php
echo ($message ?? null);

$this->Widget->clear();
$this->Widget->setBodyWrapper(false);
$this->Widget->create($this->_('AdminMain.add.boxtitle_addwebhook', true));
?>
<?php $this->Form->create(null, ['id' => 'webhook', 'class' => 'disable-on-submit']);?>
<div class="card-body">
    <h6 class="form-section-header"><?php $this->_('AdminMain.add.heading_event');?></h6>

    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminMain.add.field_callback', true), 'callback', ['class' => 'form-label']);
        ?>
        <div class="d-flex align-items-center">
            <label class="mb-0 me-1 callback_url"><?php echo $this->Html->safe('http://' . Configure::get('Blesta.company')->hostname . $this->base_uri . 'plugin/webhooks/trigger/index/');?></label>
            <?php
            $this->Form->fieldText('callback', ($vars->callback ?? null), ['id' => 'callback', 'class' => 'form-control']);
            ?>
            <span class="ms-2" data-bs-toggle="tooltip" data-bs-title="<?php $this->_('AdminMain.!tooltip.callback');?>"><i class="bi bi-info-circle"></i></span>
        </div>
    </div>

    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminMain.add.field_event', true), 'event', ['class' => 'form-label']);
        ?>
        <div class="row">
            <?php
            foreach ($events ?? [] as $event => $name) {
            ?>
                <div class="col-md-3">
                    <div class="form-check">
                        <?php
                        $this->Form->fieldCheckbox('events[]', $event, in_array($event, $vars->events ?? []), ['id' => 'events_' . $event, 'class' => 'form-check-input']);
                        $this->Form->label($name, 'events_' . $event, ['class' => 'form-check-label']);
                        ?>
                    </div>
                </div>
            <?php
            }
            ?>
        </div>
    </div>

    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminMain.add.field_type', true), 'type', ['class' => 'form-label']);
        $this->Form->fieldSelect('type', ($types ?? null), ($vars->type ?? null), ['id' => 'type', 'class' => 'form-select']);
        ?>
    </div>

    <div class="mb-3">
        <?php
        $this->Form->label($this->_('AdminMain.add.field_method', true), 'method', ['class' => 'form-label']);
        $this->Form->fieldSelect('method', ($methods ?? null), ($vars->method ?? null), ['id' => 'method', 'class' => 'form-select']);
        ?>
    </div>

    <h6 class="form-section-header"><?php $this->_('AdminMain.add.heading_fields_map');?></h6>
    <p><?php $this->_('AdminMain.add.text_fields_map');?></p>

    <div class="mb-3">
        <a class="btn btn-outline-secondary btn-sm field_row_add" href="#"><i class="bi bi-plus-lg"></i> <?php $this->_('AdminMain.add.field_add_field');?></a>
    </div>

    <table class="table table-hover fields_table">
        <thead>
            <tr>
                <th><?php $this->_('AdminMain.add.heading_field');?></th>
                <th><?php $this->_('AdminMain.add.heading_parameter');?></th>
                <th><?php $this->_('AdminMain.add.heading_options');?></th>
            </tr>
        </thead>
        <tbody>
            <?php
            $i = 0;
            if (empty($vars->fields)) {
                $vars->fields = [['field' => null, 'parameter' => null]];
            }

            foreach ($vars->fields ?? [] as $field) {
                $field = (array) $field;
            ?>
                <tr class="field_row">
                    <td>
                        <?php
                        $this->Form->fieldText('fields[' . $i . '][field]', ($field['field'] ?? null), ['class' => 'form-control']);
                        ?>
                    </td>
                    <td>
                        <?php
                        $this->Form->fieldText('fields[' . $i . '][parameter]', ($field['parameter'] ?? null), ['class' => 'form-control']);
                        ?>
                    </td>
                    <td>
                        <a class="btn btn-outline-danger btn-sm field_row_delete" href="#"><?php $this->_('AdminMain.add.option_delete');?></a>
                    </td>
                </tr>
            <?php
                $i++;
            }
            unset($i);
            ?>
        </tbody>
    </table>
</div>
<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end gap-2">
    <a class="btn btn-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'plugin/webhooks/admin_main/');?>"><?php $this->_('AdminMain.add.field_cancel');?></a>
    <?php
    $this->Form->fieldSubmit('save', $this->_('AdminMain.add.field_addsubmit', true), ['class' => 'btn btn-primary float-end']);
    ?>
</div>
<?php $this->Form->end();?>
<?php $this->Widget->end();?>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var add_btn = document.querySelector('.field_row_add');
        var type_select = document.getElementById('type');
        var callback_url = document.querySelector('.callback_url');

        // Add field row
        add_btn.addEventListener('click', function(e) {
            e.preventDefault();
            var table = document.querySelector('table.fields_table tbody');
            var rows = table.querySelectorAll('tr.field_row');
            var last_row = rows[rows.length - 1];
            var new_row = last_row.cloneNode(true);

            // Clear input values
            new_row.querySelectorAll('input[type="text"]').forEach(function(input) {
                input.value = '';
            });

            // Update indices
            var new_index = rows.length;
            new_row.querySelectorAll('input').forEach(function(input) {
                input.name = input.name.replace(/\[\d+\]/, '[' + new_index + ']');
            });

            table.appendChild(new_row);
        });

        // Delete field row (delegated)
        document.querySelector('table.fields_table').addEventListener('click', function(e) {
            if (e.target.closest('.field_row_delete')) {
                e.preventDefault();
                var rows = document.querySelectorAll('tr.field_row');
                if (rows.length > 1) {
                    e.target.closest('tr').remove();
                }
            }
        });

        // Type toggle
        function toggleCallback() {
            callback_url.style.display = type_select.value === 'incoming' ? '' : 'none';
        }

        toggleCallback();
        type_select.addEventListener('change', toggleCallback);

        // Initialize Bootstrap tooltips
        var tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltips.forEach(function(el) {
            new bootstrap.Tooltip(el);
        });
    });
</script>
